# ============================================================
# BadmintonHub — Environment Template
# Copy this file to .env and fill in your real values.
# This file IS safe to commit (no real secrets).
# ============================================================

# ===========================
# INFRASTRUCTURE — defaults match docker-compose.yml
# ===========================
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

DB_USER_URL=jdbc:postgresql://localhost:5441/user_db
DB_COURT_URL=jdbc:postgresql://localhost:5433/court_db
DB_BOOKING_URL=jdbc:postgresql://localhost:5434/booking_db
DB_MATCHMAKING_URL=jdbc:postgresql://localhost:5435/matchmaking_db
DB_PAYMENT_URL=jdbc:postgresql://localhost:5436/payment_db
DB_ESCROW_URL=jdbc:postgresql://localhost:5437/escrow_db
DB_COACH_URL=jdbc:postgresql://localhost:5438/coach_db
DB_EVENT_URL=jdbc:postgresql://localhost:5439/event_db

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

MONGODB_URI=mongodb://localhost:27017/notification_db

# chat-service — DEDICATED Mongo server (mongodb-chat:27018), separate from notification (:27017)
MONGODB_CHAT_URI=mongodb://localhost:27018/chat_db

# RabbitMQ STOMP relay — broker for chat-service enableStompBrokerRelay (rabbitmq_stomp plugin :61613)
RABBITMQ_HOST=localhost
RABBITMQ_STOMP_PORT=61613
RABBITMQ_USER=badminton
RABBITMQ_PASS=badminton
# false = chat-service uses the in-memory simple broker (single instance, no RabbitMQ).
# true (default) = STOMP relay to RabbitMQ, required for >1 instance without sticky sessions.
CHAT_BROKER_RELAY=true

ELASTICSEARCH_URIS=http://localhost:9200

ZIPKIN_URL=http://localhost:9411/api/v2/spans
# ai-service tracing → Zipkin. Set false to disable tracing entirely (demo without Zipkin).
# When true but Zipkin is down, ai-service probes it at boot and skips tracing silently (no log spam).
OTEL_ENABLED=true

EUREKA_URL=http://localhost:8761/eureka/

# ===========================
# APP TUNABLES — hold / expiry windows (minutes)
# Keep PAYMENT_EXPIRE_MINUTES == BOOKING_HOLD_MINUTES so a booking hold and its
# payment countdown expire together. Lower to 1 for fast end-to-end testing.
# ===========================
BOOKING_HOLD_MINUTES=10
PAYMENT_EXPIRE_MINUTES=10
# Absolute ceiling on a hold measured from bookings.created_at, re-anchored by
# begin-payment. Stops an owner from squatting slots indefinitely (409 BOOKING_HOLD_EXHAUSTED).
BOOKING_MAX_HOLD_MINUTES=30

# ===========================
# JWT — HS256
# Generate: openssl rand -hex 64
# ===========================
JWT_SECRET=FILL_IN
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ===========================
# GOOGLE OAUTH2
# https://console.cloud.google.com → APIs & Services → Credentials
# ===========================
GOOGLE_CLIENT_ID=FILL_IN
GOOGLE_CLIENT_SECRET=FILL_IN

# ===========================
# SENDGRID
# https://app.sendgrid.com/settings/api_keys
# ===========================
SENDGRID_API_KEY=FILL_IN
SENDGRID_FROM_EMAIL=noreply@badmintonhub.vn
SENDGRID_FROM_NAME=BadmintonHub

# ===========================
# FRONTEND (base URL for email links — verify email / reset password)
# ===========================
FRONTEND_URL=http://localhost:5173

# ===========================
# CLOUDINARY
# https://console.cloudinary.com/settings/api-keys
# ===========================
CLOUDINARY_CLOUD_NAME=FILL_IN
CLOUDINARY_API_KEY=FILL_IN
CLOUDINARY_API_SECRET=FILL_IN

# ===========================
# AI SERVICE (Python · FastAPI · LangGraph · MCP) — see ai-service/README.md + GO_LIVE_CHECKLIST.md
# Provider-agnostic: LLM_PROVIDER selects the CHAT model; default = Ollama local (qwen2.5:3b).
#
# PROVIDER POSTURE (Day 7 go-live): the concierge sends PII (phone / booking intent) to the LLM.
#   • Default = LLM_PROVIDER=ollama → chat runs on your machine, PII never leaves the box (no external
#     API). `ollama pull qwen2.5:3b` first. This already meets the no-train condition for chat.
#   • Cloud alternatives (provider-agnostic switch): LLM_PROVIDER=gemini with a BILLING key = no-train
#     cloud (Google won't train on paid API data); or =openai. Free-tier Gemini = DEMO only, no real PII.
#   • ⚠️ RAG embeddings still call Gemini (gemini-embedding-001) regardless of the chat provider, so
#     GEMINI_API_KEY is still required FOR RAG unless you also swap the embedder. Never commit a real key.
# ===========================
LLM_PROVIDER=ollama
# Local chat model — needs Ollama running (https://ollama.com) + `ollama pull qwen2.5:3b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# https://aistudio.google.com/apikey  — REQUIRED FOR RAG embeddings (and if you switch chat to gemini)
GEMINI_API_KEY=FILL_IN
# https://platform.openai.com/api-keys  (kept for provider-agnostic switch)
OPENAI_API_KEY=FILL_IN
# ai_db (postgres-ai on host port 5440) — SQLAlchemy async DSN
AI_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5440/ai_db
# ai-service calls court/booking/payment through the gateway (never a hardcoded host)
GATEWAY_URL=http://localhost:3000
# Day 4 RAG — Gemini embedding model (768-dim) over pgvector on ai_db; cosine floor to answer
# gemini-embedding-001 = stable GA (text-embedding-004 was removed for new keys)
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768
RAG_TOP_K=4
RAG_MIN_SCORE=0.68
# Day 6 — per-user rate limit (fail-open) + PII retention window. Sessions AND their transcript /
# checkpointer thread state are purged after SESSION_TTL_MINUTES by the periodic sweeper.
AI_RATE_LIMIT_PER_MINUTE=20
SESSION_TTL_MINUTES=1440
TRANSCRIPT_RETENTION_MINUTES=1440
# --- DEV debugging: see what the LLM actually received and replied ---------------------------
# Zipkin shows service hops but never prompts. LangSmith does: one trace per user turn, a tree of
# graph nodes (perceive → memory_load → gate → agent → rank_propose → ...), and for every LLM call
# the verbatim prompt + raw response + tokens + latency. No new dependency — `langsmith` already
# ships with langchain-core; ai-service just exports these into os.environ at startup.
# ⚠️ ON = conversation content (incl. names/phones) is sent to LangSmith's cloud. DEV ONLY.
# Get a free key at https://smith.langchain.com → Settings → API Keys.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=FILL_IN
LANGSMITH_PROJECT=badmintonhub-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Turn OFF PII masking in local logs + agent_run_log rows (masking hides exactly the field you're
# debugging when the bug is in contact handling). Prod MUST leave this false — see
# ai-service/GO_LIVE_CHECKLIST.md §4.
AI_DEV_RAW_PII=false

# ===========================
# FCM (Firebase Cloud Messaging)
# https://console.firebase.google.com → Project Settings → Service accounts
# ===========================
FCM_SERVER_KEY=FILL_IN
