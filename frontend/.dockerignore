# node_modules is reinstalled from package-lock.json inside the image (npm ci); copying
# the host copy would be ~169 MB of wasted context and could carry host-arch binaries.
node_modules
dist
dist-ssr
build

# VITE_* would be baked into the bundle — the whole point of same-origin is to have no
# environment baked in.
.env
.env.*

Dockerfile
.dockerignore
*.log
.DS_Store
